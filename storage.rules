rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function validImage() {
      return request.resource != null
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Identity documents must never be publicly readable.
    match /private_identity/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
      allow update: if false;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Rental photos are visible only through published listings; files are public
    // because the current client stores Firebase download URLs in public listing docs.
    match /rentalListings/{uid}/{listingId}/{fileName} {
      allow read: if true;
      allow create: if isOwner(uid) && validImage();
      allow update: if false;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Event photos follow the public event listing visibility.
    match /events/{uid}/{eventId}/{fileName} {
      allow read: if true;
      allow create: if isOwner(uid) && validImage();
      allow update: if false;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Public Reels video files; upload is restricted to owners with approved identity.
    match /reels/{uid}/{fileName} {
      allow read: if true;
      // Any authenticated owner may upload a Reel; keep file size and video type limits.
      allow create: if isOwner(uid)
        && request.resource != null
        && request.resource.size <= 30 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
      allow update: if false;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Everything else is private unless a specific rule is added after code review.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}